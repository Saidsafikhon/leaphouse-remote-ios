<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleDisplayName</key>
	<string>LeapRemote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>yandexnavi</string>
		<string>yandexmaps</string>
		<string>dgis</string>
		<string>waze</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uz.electro.remote.action</string>
			<key>CFBundleURLSchemes</key>
			<array><string>leapremote</string></array>
		</dict>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID нужен, чтобы открывать приложение без ввода кода.</string>
	<key>NSCameraUsageDescription</key>
	<string>Камера нужна, чтобы отсканировать QR-код с экрана машины и привязать её к аккаунту.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Боевой сервер за TLS; стенд в локальной сети (голый IP) — по http -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Только портрет. Без этого флага валидатор App Store требует все четыре
	     ориентации «для многозадачности iPad», хотя приложение только для iPhone. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<!-- Фоновая подкачка новостей: окно BGAppRefreshTask и push с content-available -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>uz.electro.remote.newsrefresh</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Unbounded-Light.ttf</string>
		<string>Unbounded-ExtraBold.ttf</string>
		<string>Outfit-Bold.ttf</string>
		<string>Outfit-Light.ttf</string>
		<string>Outfit-Medium.ttf</string>
	</array>
</dict>
</plist>
